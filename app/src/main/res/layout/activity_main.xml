<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ── Camera preview — INVISIBLE when IDLE/MENU, VISIBLE when scanning ── -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Bounding box / detection overlay — same dimensions as preview ── -->
    <com.evensocom.psyopvisr.ui.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.evensocom.psyopvisr.ui.SpatialMapView
        android:id="@+id/spatialMapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Idle / standby screen ── -->
    <LinearLayout
        android:id="@+id/idleScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#000000"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PSYOP-VISR"
            android:textColor="#00E676"
            android:textSize="32sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.25" />

        <View
            android:layout_width="200dp"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#2200E676" />

        <TextView
            android:id="@+id/tvIdleStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONNECTING..."
            android:textColor="#80FFFFFF"
            android:textSize="13sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvIdleHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="Use G2 touchpad to scan"
            android:textColor="#40FFFFFF"
            android:textSize="11sp"
            android:fontFamily="monospace" />

    </LinearLayout>

    <!-- ── Mode chip — top-start, visible during active scan ── -->
    <TextView
        android:id="@+id/tvModeChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="5dp"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:textColor="#000000"
        android:text="FACE SCAN"
        android:background="@drawable/chip_bg"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnScanEndMode"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_margin="12dp"
        android:fontFamily="monospace"
        android:text="AUTO SCAN"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnEvenTranslation"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:fontFamily="monospace"
        android:text="EVEN TRANSLATE"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/infoPanel" />

    <Button
        android:id="@+id/btnEnrollMe"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:fontFamily="monospace"
        android:text="@string/enroll_me_button"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnEvenTranslation" />

    <TextView
        android:id="@+id/tvEnrollStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:fontFamily="monospace"
        android:text="@string/enroll_status_not_enrolled"
        android:textColor="#A0FFFFFF"
        android:textSize="10sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnEnrollMe" />

    <!-- ── Bottom floating info panel ── -->
    <LinearLayout
        android:id="@+id/infoPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="20dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@drawable/panel_bg"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Mode row: coloured dot + mode name + scan state -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/modeColorDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/circle_dot" />

            <TextView
                android:id="@+id/tvPanelMode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                tools:text="FACE SCAN" />

            <TextView
                android:id="@+id/tvScanState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="#80FFFFFF"
                tools:text="SCANNING 2/3" />
        </LinearLayout>

        <!-- Detection detail text -->
        <TextView
            android:id="@+id/tvDetections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            android:fontFamily="monospace"
            tools:text="IDENTITY: UNKNOWN  TYPE: CIVILIAN  87%" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="#33FFFFFF" />

        <!-- HUD mirror header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="→ G2 HUD"
            android:textColor="#66FFFFFF"
            android:textSize="10sp"
            android:fontFamily="monospace" />

        <!-- Mirrored HUD output -->
        <TextView
            android:id="@+id/tvHudOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:maxLines="5"
            android:ellipsize="end"
            tools:text="HDG: 247° NW   BAT: 92%&#10;────────────────────────&#10;FACE: CENTER / MID&#10;TYPE: CIVILIAN" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
